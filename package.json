{
  "name": "raul-portfolio",
  "version": "1.0.2",
  "description": "Personal portfolio website",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run images:derive",
    "build": "next build",
    "prebuild": "npm run images:derive",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "verify:export": "bash scripts/verify-export.sh",
    "verify:experience-system": "node scripts/verify-portfolio-system.mjs",
    "verify:canonical": "node scripts/verify-canonical-output.mjs",
    "images:derive": "node scripts/generate-image-derivatives.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "clsx": "^2.0.0",
    "framer-motion": "^12.35.0",
    "lenis": "^1.3.18",
    "next": "16.3.3",
    "postcss": "^8.4.31",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-parallax-tilt": "^1.7.319",
    "react-simple-maps": "^3.0.0",
    "sharp": "^0.33.5",
    "swiper": "^12.1.2",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.5",
    "web-vitals": "^3.5.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@next/bundle-analyzer": "16.3.3",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
